{
  // Static site served by Cloudflare Workers static assets. No Worker script.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gangtv-com-sg",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "gangtv.com.sg", "custom_domain": true },
    { "pattern": "www.gangtv.com.sg", "custom_domain": true }
  ]
}
